diff --git a/libxlog/xlog.c b/libxlog/xlog.c
new file mode 100644
index 000000000..34cf21ad7
--- /dev/null
+++ b/libxlog/xlog.c
@@ -0,0 +1,19 @@
+typedef __builtin_va_list va_list;
+#define va_start(ap, last) __builtin_va_start(ap, last)
+#define va_end(ap) __builtin_va_end(ap)
+
+/* Android N liblog has no bufID-variant vprint; route to the plain one.
+   Camera logs land in the MAIN buffer, which is fine. */
+extern int __android_log_vprint(int prio, const char *tag, const char *fmt,
+                                va_list ap);
+
+void __xlog_buf_printf(int bufID, int prio, const char *tag,
+                       const char *fmt, ...)
+{
+    va_list ap;
+
+    (void)bufID;
+    va_start(ap, fmt);
+    __android_log_vprint(prio, tag, fmt, ap);
+    va_end(ap);
+}
