From ad39e145285cb14336d3bd62e6b27e6d9b91fb9f Mon Sep 17 00:00:00 2001
From: CoreXGT <aulia.ikbal09@gmail.com>
Date: Thu, 10 Sep 2026 04:32:25 +0700
Subject: [PATCH 2/2] netd: make ipv6 rpfilter tether rule non-fatal for
 hotspot

 MTK 3.18 kernel lacks xt_rpfilter, so 'ip6tables -t raw -m rpfilter'
 fails on nikel. NatController aborted the whole nat enable, and the
 framework reacted by tearing down the soft AP (hotspot dies ~1s after
 AP-ENABLED with 'Nat operation failed (No such device)' in the log).
 Skip the rule instead of failing the nat.

Change-Id: I2d3378f31b1837a967d63578e2c915c91fe75bbb
---
 server/NatController.cpp | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/server/NatController.cpp b/server/NatController.cpp
index cda8f5f..41ed377 100644
--- a/server/NatController.cpp
+++ b/server/NatController.cpp
@@ -377,8 +377,12 @@ int NatController::setForwardRules(bool add, const char *intIface, const char *e
     }
 
     if (runCmd(ARRAY_SIZE(cmd4), cmd4) && add) {
-        rc = -1;
-        goto err_rpfilter;
+        /* nikel: MTK 3.18 kernel has no xt_rpfilter module — the IPv6
+           anti-spoof rule cannot be installed. Aborting here makes the
+           whole nat enable fail, and the framework then tears down the
+           hotspot ("Nat operation failed (No such device)"). Just skip
+           the rule and continue. */
+        ALOGE("ip6tables rpfilter rule unsupported by kernel, skipping");
     }
 
     if (setTetherCountingRules(add, intIface, extIface) && add) {
@@ -388,9 +392,6 @@ int NatController::setForwardRules(bool add, const char *intIface, const char *e
 
     return 0;
 
-err_rpfilter:
-    cmd3[2] = "-D";
-    runCmd(ARRAY_SIZE(cmd3), cmd3);
 err_return:
     cmd2[2] = "-D";
     runCmd(ARRAY_SIZE(cmd2), cmd2);
-- 
2.53.0

