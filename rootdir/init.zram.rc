# zRAM swap untuk nikel — swap berbasis RAM (kernel zram, kompresi lzo).
# RAM usable ~2.7GB (varian 3GB); swap zram = 1GB.
# Note: swapon ini di-zRAM, bukan swapfile di userdata.

on boot
    # 1 GB dalam byte
    write /sys/block/zram0/disksize 1073741824
    exec - - -- /system/bin/mkswap /dev/block/zram0
    exec - - -- /system/bin/swapon /dev/block/zram0
